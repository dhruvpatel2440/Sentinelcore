# Scripts executed on Linux must keep LF line endings even when edited on Windows.
*.sh                       text eol=lf
installer/sentinelcore     text eol=lf
installer/sentinelcore-installer text eol=lf
*.service                  text eol=lf
*.conf                     text eol=lf
Dockerfile*                text eol=lf
*.yml                      text eol=lf
*.py                      text eol=lf
*.json                    text eol=lf
*.md                      text eol=lf
*.mjs                     text eol=lf
