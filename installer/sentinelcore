#!/usr/bin/python3
"""sentinelcore: management CLI (install, status, doctor, backup, update, ...)."""
import os
import sys

# Installed layout: /usr/lib/sentinelcore/sentinelcore_installer. From a checkout
# the package sits next to this file.
for candidate in ("/usr/lib/sentinelcore", os.path.dirname(os.path.abspath(__file__))):
    if os.path.isdir(os.path.join(candidate, "sentinelcore_installer")):
        sys.path.insert(0, candidate)
        break

from sentinelcore_installer.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
