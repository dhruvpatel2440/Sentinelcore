# Copy to .env and fill in. NEVER commit .env.

# Database
POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelcore
# docker-compose overrides this for the backend/worker containers with the
# asyncpg driver and the `db` hostname. This value is for host-side tooling.
DATABASE_URL=postgresql+asyncpg://sentinelcore:change-me@localhost:5432/sentinelcore

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-long-random-string-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Bootstrap admin. Leave SEED_ADMIN_PASSWORD unset to have a strong one
# generated and printed once in the backend container logs on first boot.
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=24cs040@charusat.edu.in

# Network
CAPTURE_INTERFACE=enp0s8
MONITORED_NETWORK=192.168.56.0/24
# Gateway, DNS and self — can NEVER be firewall-blocked (M10)
PROTECTED_IPS=192.168.56.1,192.168.56.102

# Suricata
SURICATA_EVE_LOG=/var/log/suricata/eve.json

# Redis
REDIS_URL=redis://redis:6379/0

# Pipeline (M5)
EVENT_RETENTION_DAYS=90

# development | production — production hides /api/docs and marks cookies Secure
ENVIRONMENT=development

# U10 — email notifications (Brevo). See docs/email.md.
# off (default, no sending) | dry_run (render + store, don't send) | brevo
EMAIL_MODE=brevo
# Never commit a real key. Required when EMAIL_MODE=brevo.
BREVO_API_KEY=
# Must be a registered and verified sender in your Brevo account.
EMAIL_SENDER_ADDRESS=dhruvpatel2440@gmail.com
EMAIL_SENDER_NAME=SentinelCore
EMAIL_REPLY_TO=
APP_BASE_URL=https://sentinel.lab
# Comma list; empty = any registered user email is eligible
EMAIL_ALLOWED_RECIPIENT_DOMAINS=
EMAIL_DAILY_CAP_PER_RECIPIENT=50
EMAIL_GLOBAL_DAILY_CAP=250
EMAIL_MAX_ATTACHMENT_MB=5
# Shared secret for the Brevo delivery-event webhook. Generate with: openssl rand -hex 32
BREVO_WEBHOOK_SECRET=
