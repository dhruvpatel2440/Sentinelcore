
# Database
POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=sentinelcore123
POSTGRES_DB=sentinelcore
DATABASE_URL=postgresql://sentinelcore:sentinelcore123@localhost:5432/sentinelcore

# Auth
SECRET_KEY=change-this-to-a-very-long-random-string-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Network
CAPTURE_INTERFACE=eth1
MONITORED_NETWORK=192.168.10.0/24
PROTECTED_IPS=192.168.10.1,192.168.10.2

# Suricata
SURICATA_EVE_LOG=/var/log/suricata/eve.json

# Redis
REDIS_URL=redis://localhost:6379
